# ──────────────────────────────────────────────────────────────
# Chili Analysis — environment configuration
# Copy to .env.local and fill in the keys for whichever providers
# you have. Leave USE_LIVE_DATA unset (or =0) to keep serving the
# design fixtures — useful for dev, demos, and CI.
# ──────────────────────────────────────────────────────────────

# Master switch. "1" = call upstream providers; anything else = fixtures.
USE_LIVE_DATA=0

# ── Structural data: fixtures, standings, teams, squads, events ──
# Sign up: https://dashboard.api-football.com (direct) or RapidAPI
API_FOOTBALL_KEY=
# Default league + season used by routes that need a scope
API_FOOTBALL_LEAGUE_ID=39
API_FOOTBALL_SEASON=2024

# ── Advanced metrics: xG, shot coords, PPDA, heatmaps ──
# Pick one provider and wire it in lib/providers/statsbomb.ts
# StatsBomb Open Data (free, non-commercial): no key needed, just the open data repo
# Stats Perform / Opta: enterprise, license required
# Understat: scraping only, use at your own risk
STATSBOMB_API_KEY=

# ── Weather for match venue ──
# https://openweathermap.org/api (free tier available)
OPENWEATHER_KEY=

# ── Own data: blog posts and user notes ──
# Recommended: Postgres + Drizzle/Prisma, or Sanity/Contentful/Ghost
DATABASE_URL=
CMS_ENDPOINT=
